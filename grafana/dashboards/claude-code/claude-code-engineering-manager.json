      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": false,
            "thresholdsStyle": { "mode": "line" }
          },
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "green", "value": 70 }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "id": 8,
      "options": {
        "legend": { "calcs": ["lastNotNull", "mean"], "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(claude_code_code_edit_tool_decision_total{decision=\"accept\"}[$__rate_interval]))\n/ sum(rate(claude_code_code_edit_tool_decision_total[$__rate_interval])) * 100",
          "legendFormat": "team acceptance rate",
          "refId": "A"
        }
      ],
      "title": "Team-Wide Edit Acceptance Rate Trend",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Daily active time (left) and session count (right) for the team. Useful context for onboarding or tooling changes. Daily bars eliminate session-boundary spikes.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "barAlignment": 0,
            "drawStyle": "bars",
            "fillOpacity": 70,
            "lineWidth": 0,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "sessions" },
            "properties": [
              { "id": "custom.axisPlacement", "value": "right" },
