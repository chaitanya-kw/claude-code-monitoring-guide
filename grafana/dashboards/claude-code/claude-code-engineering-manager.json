      "options": {
        "legend": { "calcs": [], "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(increase(claude_code_active_time_seconds_total[$__interval]))",
          "interval": "1d",
          "legendFormat": "active time (s)",
          "refId": "A"
