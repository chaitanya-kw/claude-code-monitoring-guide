    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Daily token consumption stacked by type (left axis) + cache read ratio over time (right axis, white line). A rising cache ratio = improving prompt discipline.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "barAlignment": 0,
            "drawStyle": "bars",
            "fillOpacity": 100,
            "lineWidth": 0,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "normal" }
          },
          "unit": "short"
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "cacheRead" }, "properties": [{ "id": "color", "value": { "fixedColor": "#73BF69", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "cacheCreation" }, "properties": [{ "id": "color", "value": { "fixedColor": "#5794F2", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "input" }, "properties": [{ "id": "color", "value": { "fixedColor": "#FADE2A", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "output" }, "properties": [{ "id": "color", "value": { "fixedColor": "#FF780A", "mode": "fixed" } }] },
          {
            "matcher": { "id": "byName", "options": "cache ratio %" },
            "properties": [
              { "id": "custom.drawStyle", "value": "line" },
              { "id": "custom.fillOpacity", "value": 0 },
              { "id": "custom.lineWidth", "value": 2 },
              { "id": "custom.stacking", "value": { "mode": "none" } },
              { "id": "custom.axisPlacement", "value": "right" },
              { "id": "custom.axisLabel", "value": "cache ratio %" },
              { "id": "custom.showPoints", "value": "always" },
              { "id": "custom.pointSize", "value": 5 },
              { "id": "unit", "value": "percent" },
              { "id": "min", "value": 0 },
              { "id": "max", "value": 100 },
              { "id": "color", "value": { "fixedColor": "#ffffff", "mode": "fixed" } }
