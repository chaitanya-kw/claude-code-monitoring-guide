      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(increase(claude_code_token_usage_tokens_total{user_email=\"$user_email\",project=~\"$project\",type=\"cacheRead\"}[$__interval]))",
          "interval": "1d",
          "legendFormat": "cacheRead",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
