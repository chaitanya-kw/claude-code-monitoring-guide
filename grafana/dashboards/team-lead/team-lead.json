{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Team-level Claude Code metrics for engineering leads. Focus: adoption, acceptance rate, and engagement patterns.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Edit acceptance rate per developer over time. Spot team-wide drops after model updates or config changes. Individual lines reveal who is improving and who needs coaching.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "fillOpacity": 5,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": false,
            "thresholdsStyle": { "mode": "line+area" }
          },
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "transparent", "value": null },
              { "color": "transparent", "value": 50 },
              { "color": "transparent", "value": 70 }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "legend": { "calcs": ["lastNotNull", "mean"], "displayMode": "table", "placement": "right" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (user_email) (rate(claude_code_code_edit_tool_decision_total{decision=\"accept\"}[$__rate_interval]))\n/\nsum by (user_email) (rate(claude_code_code_edit_tool_decision_total[$__rate_interval]))\n* 100",
          "legendFormat": "{{user_email}}",
          "refId": "A"
        }
      ],
      "title": "Acceptance Rate Trend — All Developers",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Snapshot acceptance rate per developer for the selected window. Sort ascending to find outliers. Pair with the trend above to distinguish a temporary dip from a sustained problem.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "green", "value": 70 }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "id": 2,
      "options": {
        "cellHeight": "sm",
        "footer": { "countRows": false, "reducer": ["sum"], "show": false },
        "showHeader": true,
        "sortBy": [{ "desc": true, "displayName": "Value" }]
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (user_email) (increase(claude_code_code_edit_tool_decision_total{decision=\"accept\"}[$__range]))\n/\nsum by (user_email) (increase(claude_code_code_edit_tool_decision_total[$__range]))\n* 100",
          "format": "table",
          "instant": true,
          "legendFormat": "Acceptance Rate %",
          "refId": "A"
        }
      ],
      "title": "Edit Acceptance Rate by Developer",
      "transformations": [
        { "id": "organize", "options": { "renameByName": { "Value": "Acceptance Rate %", "user_email": "Developer" } } }
      ],
      "type": "table"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Active time and session count per developer for the selected window. Low acceptance + short sessions = prompting problems; low acceptance + long sessions = model fit issue.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 80, "gradientMode": "none" }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Sessions" },
            "properties": [
              { "id": "custom.axisPlacement", "value": "right" },
              { "id": "unit", "value": "short" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Active Time" },
            "properties": [
              { "id": "unit", "value": "s" }
            ]
          }
        ]
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "id": 3,
      "options": {
        "barRadius": 0,
        "barWidth": 0.97,
        "fillOpacity": 80,
        "groupWidth": 0.7,
        "legend": { "displayMode": "list", "placement": "bottom" },
        "orientation": "auto",
        "tooltip": { "mode": "multi", "sort": "none" },
        "xTickLabelRotation": -30,
        "xTickLabelSpacing": 0
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (user_email) (increase(claude_code_active_time_seconds_total[$__range]))",
          "legendFormat": "{{user_email}}",
          "format": "table",
          "instant": true,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (user_email) (increase(claude_code_session_count_total[$__range]))",
          "legendFormat": "{{user_email}}",
          "format": "table",
          "instant": true,
          "refId": "B"
        }
      ],
      "title": "Active Time vs Sessions by Developer",
      "transformations": [
        { "id": "merge", "options": {} },
        { "id": "organize", "options": { "renameByName": { "Value #A": "Active Time", "Value #B": "Sessions", "user_email": "Developer" } } }
      ],
      "type": "barchart"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Average session length per developer per day. Rising bars = deeper workflow integration. Uses daily bucketing to avoid session-boundary spikes.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "barAlignment": 0,
            "drawStyle": "bars",
            "fillOpacity": 70,
            "lineWidth": 0,
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 17 },
      "id": 4,
      "options": {
        "legend": { "calcs": ["mean"], "displayMode": "table", "placement": "right" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (user_email) (increase(claude_code_active_time_seconds_total[$__interval]))\n/\nsum by (user_email) (increase(claude_code_session_count_total[$__interval]))",
          "interval": "1d",
          "legendFormat": "{{user_email}}",
          "refId": "A"
        }
      ],
      "title": "Average Session Length by Developer",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Token volume per developer — reveals who is and is not using Claude Code.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 80, "gradientMode": "none" },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 17 },
      "id": 5,
      "options": {
        "barRadius": 0,
        "barWidth": 0.97,
        "fillOpacity": 80,
        "groupWidth": 0.7,
        "legend": { "displayMode": "list", "placement": "bottom" },
        "orientation": "auto",
        "tooltip": { "mode": "single", "sort": "none" },
        "xTickLabelRotation": -30,
        "xTickLabelSpacing": 0
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (user_email) (increase(claude_code_token_usage_tokens_total[$__range]))",
          "legendFormat": "{{user_email}}",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Token Usage by Developer",
      "transformations": [
        { "id": "labelsToFields", "options": { "valueLabel": "user_email" } }
      ],
      "type": "barchart"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Token volume per developer, broken down by model. Flags unintended model use across the team.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "fillOpacity": 70,
            "stacking": { "group": "A", "mode": "normal" }
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 25 },
      "id": 6,
      "options": {
        "barRadius": 0,
        "barWidth": 0.97,
        "fillOpacity": 80,
        "groupWidth": 0.7,
        "legend": { "displayMode": "list", "placement": "bottom" },
        "orientation": "auto",
        "stacking": "normal",
        "tooltip": { "mode": "multi", "sort": "none" },
        "xTickLabelRotation": -30,
        "xTickLabelSpacing": 0
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (user_email, model) (increase(claude_code_token_usage_tokens_total[$__range]))",
          "legendFormat": "{{user_email}} / {{model}}",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Per Developer, Per Model Token Usage",
      "transformations": [
        { "id": "labelsToFields", "options": { "valueLabel": "user_email" } }
      ],
      "type": "barchart"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Top 5 developers by token rate over the last 5 minutes — who is actively using Claude Code right now.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 80, "gradientMode": "none" },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 25 },
      "id": 7,
      "interval": "30s",
      "options": {
        "barRadius": 0,
        "barWidth": 0.97,
        "fillOpacity": 80,
        "groupWidth": 0.7,
        "legend": { "displayMode": "list", "placement": "bottom" },
        "orientation": "horizontal",
        "tooltip": { "mode": "single", "sort": "none" },
        "xTickLabelRotation": 0,
        "xTickLabelSpacing": 0
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "topk(5, sum by (user_email) (rate(claude_code_token_usage_tokens_total[5m])))",
          "legendFormat": "{{user_email}}",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Top Consumers Right Now",
      "transformations": [
        { "id": "labelsToFields", "options": { "valueLabel": "user_email" } }
      ],
      "type": "barchart"
    }
  ],
  "refresh": "30s",
